# Safe example only. Do not put real production values in Git.
ENVIRONMENT=development
SECRET_KEY=replace_with_at_least_32_random_characters

APP_HOST=127.0.0.1
APP_PORT=5100
DB_PATH=/opt/servicesite/instance/servicesite.db

# Planned single-admin authentication (implemented in a later task).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_a_generated_password_hash
ADMIN_SESSION_HOURS=12

# Planned internal poll protection.
X_INTERNAL_TOKEN=replace_with_a_strong_random_token

# XMR settings are completed and validated in Task 2.
XMR_WALLET_RPC_URL=http://127.0.0.1:PORT/json_rpc
XMR_WALLET_RPC_USER=replace_with_rpc_username
XMR_WALLET_RPC_PASS=replace_with_rpc_password
XMR_ACCOUNT_INDEX=0
XMR_MIN_CONFIRMATIONS=10
XMR_SWEEP_ENABLED=false
XMR_COLD_ADDRESS=replace_only_when_sweeping_is_approved

# The production rate source and quote-age policy remain blocked decisions.
XMR_RATE_SOURCE=replace_in_task_2
XMR_QUOTE_MAX_AGE_SECONDS=replace_in_task_2
