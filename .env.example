# Safe example only. Do not put real production values in Git.
ENVIRONMENT=development
SECRET_KEY=replace_with_at_least_32_random_characters

APP_HOST=127.0.0.1
APP_PORT=5100
DB_PATH=/opt/servicesite/instance/servicesite.db

# Planned single-admin authentication (implemented in a later task).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_a_generated_password_hash
ADMIN_SESSION_HOURS=12

# Internal polling is implemented later; production startup already requires a
# strong value so the contract cannot be deployed accidentally without one.
X_INTERNAL_TOKEN=replace_with_a_strong_random_token

# XMR wallet-RPC transport. Credentials are separate from the URL and wallet-RPC
# must use HTTP Digest authentication. XMR_RPC_RETRIES is the total bounded
# attempt count, including the first request.
XMR_WALLET_RPC_URL=http://127.0.0.1:28088/json_rpc
XMR_WALLET_RPC_USER=replace_with_rpc_username
XMR_WALLET_RPC_PASS=replace_with_rpc_password
XMR_ACCOUNT_INDEX=0
XMR_RPC_TIMEOUT=20
XMR_RPC_RETRIES=3
XMR_RPC_RETRY_BACKOFF=1.0
XMR_MIN_CONFIRMATIONS=10
XMR_INVOICE_TTL_SECONDS=7200

# Keep sweeping disabled until staged reconciliation tests pass. Keep the safe
# placeholder while disabled; never commit a production address.
XMR_SWEEP_ENABLED=false
XMR_COLD_ADDRESS=replace_only_when_sweeping_is_approved
XMR_SWEEP_ACCOUNT_INDEX=0
XMR_SWEEP_PRIORITY=2
XMR_SWEEP_RELAY=true

# DANGEROUS: keep false. Production otherwise rejects non-loopback/non-private
# wallet-RPC endpoints.
ALLOW_PUBLIC_XMR_WALLET_RPC=false

# Pricing is implemented in a later task. The operator must still choose the
# production rate source and maximum quote age before checkout is enabled.
XMR_RATE_SOURCE=replace_with_approved_rate_source
XMR_QUOTE_MAX_AGE_SECONDS=replace_with_approved_maximum_age
