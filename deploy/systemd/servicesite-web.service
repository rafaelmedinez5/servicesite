[Unit]
Description=Servicesite Gunicorn web application
Wants=network-online.target servicesite-wallet-rpc.service
After=network-online.target servicesite-wallet-rpc.service

[Service]
Type=notify
NotifyAccess=main
User=servicesite
Group=servicesite
WorkingDirectory=/opt/servicesite/app
EnvironmentFile=/etc/servicesite/servicesite.env
ExecStart=/opt/servicesite/.venv/bin/gunicorn --config python:app.gunicorn_config wsgi:app
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/servicesite/instance /opt/servicesite/logs

[Install]
WantedBy=multi-user.target
